{
  "name": "dsh-web-search-searxng",
  "version": "0.0.3",
  "description": "SearXNG for DeepSeek Harness: registers a self-hosted SearXNG instance as the web_search provider and exposes searxng_scholar plus an optional standalone searxng_search tool",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node --check lib/index.js && node scripts/smoke.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:dsh": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dsh-headless-test.ps1"
  },
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1"
  },
  "license": "MIT"
}
